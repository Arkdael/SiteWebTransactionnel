@model Produit[]

@{
	ViewData["Title"] = "Liste";
}

<h1>Index</h1>

<p>
	<a href="/Produits/Creer" class="btn btn-primary">Create New</a>
</p>

<div class="container">
	<div class="row g-3">
		@foreach (var produit in Model)
		{
			<div class="col-12 col-sm-6 col-md-4 col-lg-3">
				<div class="card h-100 shadow-sm">
					<!-- Engrenage en haut à droite de la carte -->
					<div class="dropdown" style="position:absolute; top:10px; right:10px; z-index:10;">
						<a class="text-decoration-none" href="#" role="button" id="dropdownMenuLink-@produit.Id"data-bs-toggle="dropdown" aria-expanded="false">
							⚙
						</a>
						<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuLink-@produit.Id">
							<li><a class="dropdown-item" href="./Modifier/@produit.Id">Edit</a></li>
							<li><a class="dropdown-item" href="./Supprimer/@produit.Id">Delete</a></li>
						</ul>
					</div>
					<a class="text-decoration-none" style="color: inherit" href=./Details/@produit.Id">
						<div class="card-body d-flex flex-column">
							<div style="background-color:gray; height:200px; lenght:200px;"></div>
								<h5 class="card-title">
									@Html.DisplayFor(modelItem => produit.Nom)
								</h5>
							<div class="mt-auto">
								<p class="fw-bold mb-2">
									@Html.DisplayFor(modelItem => produit.Prix)$
								</p>
							</div>
						</div>
					</a>
				</div>
			</div>
		}
	</div>
</div>
