@using Microsoft.AspNetCore.Mvc.Localization
@using SiteWebTransactionnel.Localisation
@using SiteWebTransactionnel.Models.Vue

@model ProduitDétailsVM
@inject IViewLocalizer Localisateur
@inject IHtmlLocalizer<RessourcesCommunes> LocalisateurCommun

@{
	ViewData["Title"] = Localisateur["Titre"];
}

<h1>@Localisateur["Titre"]</h1>

<div>
	<h4>@LocalisateurCommun["ProduitNom"]</h4>
	<hr />
	<img src="@(Model.Images.Count() > 0 ? Model.Images.First() : "")"/>
	<dl class="row">							
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Nom)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Nom)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Description)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Description)
		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Prix)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Prix)
		</dd>
	</dl>
</div>
<div>
	<a href="/Produits/Modifier/@Model.Id">@Localisateur["ActionModifier"]</a> |
	<a href="/Produits/Liste">@Localisateur["ActionRetour"]</a>
</div>
